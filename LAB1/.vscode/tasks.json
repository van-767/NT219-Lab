{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "C/C++: g++ build active file (Crypto++)",
            "command": "/usr/bin/g++",
            "args": [
                "-g2",
                "-O3",
                "-DNDEBUG",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}",
                "-lpthread",
                "-I",
                "/home/van767/Study/CryptoPP/include",
                "-L",
                "/home/van767/Study/CryptoPP/lib/gcc",
                "-l:libcryptopp.a",
                "-Wall"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "compiler: g++ (Crypto++ static, Linux)"
        },
        {
            "type": "shell",
            "label": "Build EXE with OpenSSL (g++)",
            "command": "/usr/bin/g++",
            "args": [
                "-g2",
                "-O3",
                "-DNDEBUG",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}",
                "-I", "/usr/include",
                "-L", "/usr/lib/x86_64-linux-gnu",
                "-l:libssl.a",
                "-l:libcrypto.a",
                "-ldl",
                "-lpthread",
                "-Wall"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build active file → ELF binary using OpenSSL (g++, static link)"
        },
        {
            "type": "shell",
            "label": "Build SO with OpenSSL (g++)",
            "command": "/usr/bin/g++",
            "args": [
                "-shared",
                "-fPIC",
                "-O3",
                "-DNDEBUG",
                "-DLIB_EXPORTS",
                "-DRSAKEYGEN_BUILD_DLL",
                "${file}",
                "-o",
                "${fileDirname}/lib${fileBasenameNoExtension}.so",
                "-I", "/usr/include",
                "-L", "/usr/lib/x86_64-linux-gnu",
                "-l:libssl.a",
                "-l:libcrypto.a",
                "-ldl",
                "-lpthread",
                "-Wall"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": "build",
            "detail": "Build active file → lib<name>.so using OpenSSL (g++, static link, -fPIC -shared)"
        },
        {
            "type": "shell",
            "label": "C/C++: clang++ build active file (Crypto++)",
            "command": "/usr/bin/clang++",
            "args": [
                "-std=c++17",
                "-O3",
                "-DNDEBUG",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}",
                "-lpthread",
                "-I",
                "/home/van767/Study/CryptoPP/include",
                "-L",
                "/home/van767/Study/CryptoPP/lib/clang",
                "-l:libcryptopp.a",
                "-Wall"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "compiler: clang++ (Crypto++ static, Linux)"
        }
    ]
}
